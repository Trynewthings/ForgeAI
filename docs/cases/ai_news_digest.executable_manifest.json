{
  "manifest_version": "0.1",
  "executable_type": "single_service",
  "compatibility": {
    "mode": "native",
    "legacy_blueprint_direct_run_supported": true
  },
  "entrypoint": {
    "kind": "service_descriptor",
    "path": "service.descriptor.json",
    "handler": "run_service"
  },
  "schemas": {
    "input": "input.schema.json",
    "output": "output.schema.json",
    "config": "config.schema.json"
  },
  "execution": {
    "strategy": "sequential",
    "steps_source": "steps.json",
    "nodes_source": null
  },
  "runtime": {
    "default_env": {},
    "env_required": [],
    "debug_defaults": {}
  },
  "artifacts": {
    "spec_file": "artifact_spec.json",
    "default_outputs": ["run_summary", "digest.md", "digest.json"]
  },
  "observability": {
    "trace_enabled": true,
    "step_logs": true,
    "token_usage": true,
    "metrics": ["latency", "tokens"]
  }
}
