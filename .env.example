APP_NAME=AgentForge API
APP_ENV=development
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:1420","http://127.0.0.1:1420"]
CORS_ORIGIN_REGEX=https?://(localhost|127\\.0\\.0\\.1|tauri\\.localhost)(:\\d+)?

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentforge
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

DATABASE_URL=postgresql+psycopg://agentforge:agentforge@localhost:5432/agentforge
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
WORKER_CONCURRENCY=2
BUILD_EXECUTION_MODE=auto
BUILD_PIPELINE_MODE=full
BUILD_STEP_DELAY_SECONDS=0.4
LLM_MODE=mock
DEFAULT_LLM_PROVIDER=openai-compatible
DEFAULT_LLM_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL_NAME=gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.2
DEFAULT_LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=15

VITE_AGENTFORGE_API_URL=http://localhost:8000
